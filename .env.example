# ⚠️ 复制此文件为 .env 并填入真实值
# cp .env.example .env

# Database
POSTGRES_DB=cinedesign
POSTGRES_USER=cinedesign
POSTGRES_PASSWORD=cinedesign_dev
DATABASE_URL=postgresql://cinedesign:cinedesign_dev@localhost:5432/cinedesign

# LLM (DeepSeek V4 Flash for development)
# 填入你的 API Key
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Production models (swap later):
# LLM_MODEL=claude-opus-4-7   # via Anthropic
# LLM_MODEL=qwen3.6-plus      # via Alibaba Cloud

# Embedding
# OpenAI text-embedding-3-small 为默认，也可用 DeepSeek
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIM=768

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# 视觉模型(描述上传的基底图;留空则尝试主模型,失败自动降级为纯文本流程)
LLM_VISION_MODEL=

# 图像编辑模型(逐镜渲染关键帧, ADR-0012;可换 qwen-image-2.0-pro / wan2.7-image)
IMAGE_MODEL=qwen-image-2.0
